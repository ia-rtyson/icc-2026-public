IGNITION_LICENSE_KEY=
IGNITION_ACTIVATION_TOKEN=
IGNITION_EDGE_LICENSE_KEY=
IGNITION_EDGE_ACTIVATION_TOKEN=
GATEWAY_PORT=8088
GATEWAY_PORT_SSL=443
POSTGRES_PORT=5433
PGADMIN_PORT=5051

# --- YouTrack ---------------------------------------------------------------
# Issue tracker + state machine for the Report -> Build -> Execute pipeline.
#
# There is NO first-time setup. The `youtrack-init` service restores
# services/youtrack/seed/ into the volumes on first boot, so the tracker comes
# up already holding the UI Issues project, the Stage field, the three-column
# board and the API token that the gateway's MCP connection is configured with.
#
# The gateway reads that token from services/youtrack/seed/token.env, not from
# here -- so leave YOUTRACK_TOKEN unset unless you have provisioned YouTrack by
# hand instead of restoring the seed. A value here wins over the seed's.
#
# To provision by hand (only if you are building a NEW seed):
#   docker compose run --rm youtrack configure \
#       -J-Ddisable.configuration.wizard.on.clean.install=true \
#       --base-url=http://localhost:8089
#   docker compose up -d youtrack        # comes up on admin/admin, no wizard
#   python scripts/youtrack-setup.py --mint-token admin:admin   # token -> below
#   python scripts/youtrack-setup.py     # project, Stage field, board
#   # paste the token into Config -> AI -> MCP Servers -> youtrack
#   ./scripts/youtrack-snapshot.sh       # bake it so nobody repeats the above
YOUTRACK_VERSION=2025.3.131383
YOUTRACK_PORT=8089
YOUTRACK_TOKEN=

# Demo mail -- mailpit is the SMTP sink the gateway Email Profile points at;
# `gmail` is a static front end that renders the sink as a familiar inbox.
# These two are cosmetic: the account shown in that UI.
GMAIL_ACCOUNT=iggy@example.com
GMAIL_NAME=Iggy
GMAIL_PORT=8090
