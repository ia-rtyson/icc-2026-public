# Gmail-lookalike front end for Mailpit.
#
# Static assets are served from /usr/share/nginx/html; everything Mailpit owns
# (REST API, websocket event stream, rendered message bodies) is proxied through
# on the same origin so the reading pane can iframe message HTML without CORS or
# mixed-content problems.

resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker DNS is re-resolved because mailpit's IP changes when its container
    # is recreated; a literal hostname in proxy_pass would be cached forever.
    set $mailpit mailpit;

    # Identity the UI presents as ("to me", the avatar, the account switcher).
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 'window.GMAIL_CONFIG={"account":"${GMAIL_ACCOUNT}","name":"${GMAIL_NAME}"};';
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    # Live "new mail arrived" stream.
    location = /api/events {
        proxy_pass http://$mailpit:80$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
    }

    location /api/ {
        proxy_pass http://$mailpit:80$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Rendered message bodies and attachment parts, iframed by the reading pane.
    location /view/ {
        proxy_pass http://$mailpit:80$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}
