{
  "custom": {},
  "params": {
    "label": "",
    "value": ""
  },
  "propConfig": {
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 20,
      "width": 600
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Key"
        },
        "position": {
          "basis": "120px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "color": "var(--neutral-60)",
            "fontSize": "12px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Value"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "color": "var(--neutral-90)",
            "fontSize": "12px",
            "overflowWrap": "anywhere",
            "whiteSpace": "pre-wrap"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "baseline",
      "direction": "row",
      "style": {
        "gap": "8px"
      }
    },
    "type": "ia.container.flex"
  }
}
