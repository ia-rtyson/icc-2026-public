            },
            "props": {
              "primary": false,
              "style": {
                "fontSize": "13px",
                "height": "30px",
                "minHeight": "0px"
              },
              "text": "Ask the Agent"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t# Clears the canvas without touching anything saved -- the \"start again\" the\n\t# agent has no tool for.\n\tself.view.custom.widgets \u003d []\n\tself.view.custom.currentName \u003d \u0027\u0027\n\tself.view.custom.currentIsDemo \u003d False\n\tself.view.custom.toast \u003d \u0027\u0027"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Clear"
            },
            "position": {
              "basis": "80px",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "primary": false,
              "style": {
                "fontSize": "13px",
                "height": "30px",
                "minHeight": "0px"
              },
              "text": "Clear"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.openPopup(\n\t\t\u0027dashboard-manage\u0027,\n\t\t\u0027Exchange/Dashboard Agent/Manage Dashboards\u0027,\n\t\ttitle\u003d\u0027Saved dashboards\u0027,\n\t\tmodal\u003dTrue,\n\t\tshowCloseIcon\u003dTrue,\n\t\tdraggable\u003dTrue,\n\t\tresizable\u003dTrue,\n\t\toverlayDismiss\u003dTrue)\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Open"
            },
            "position": {
              "basis": "90px",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "primary": false,
              "style": {
                "fontSize": "13px",
                "height": "30px",
                "minHeight": "0px"
              },
              "text": "Saved"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.view.custom.toast \u003d exchange.dashboard.ui.openSaveDock(self.view.custom.widgets, self.view.custom.currentName, self.view.custom.currentIsDemo)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Save"
            },
            "position": {
              "basis": "90px",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "primary": true,
              "style": {
                "fontSize": "13px",
                "height": "30px",
                "minHeight": "0px"
              },
              "text": "Save"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Toolbar"
        },
        "position": {
          "height": "7%",
          "width": "100%",
          "x": "0%",
          "y": "0%"
        },
        "props": {
          "alignItems": "center",
          "direction": "row",
          "justify": "flex-end",
          "style": {
            "backgroundColor": "var(--neutral-20)",
            "borderBottom": "1px solid var(--neutral-40)",
            "gap": "8px",
            "padding": "0px 14px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\t# Open on the default dashboard rather than an empty grid. The layout is\n\t# loaded from the database by name (exchange.dashboard.configs.DEFAULT_NAME),\n\t# so re-saving a layout under that name changes what the page opens on.\n\texchange.dashboard.ui.applyDefault(self.view)\n"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "exchange.dashboard.load",
          "pageScope": true,
          "script": "\t# Sent by the saved-list popup\u0027s Open button (exchange.dashboard.ui.openSaved); the\n\t# popup is a separate view, so the layout arrives as a page message.\n\tself.view.custom.widgets \u003d payload[\u0027widgets\u0027]\n\tself.view.custom.currentName \u003d payload[\u0027name\u0027]\n\tself.view.custom.currentIsDemo \u003d payload[\u0027isDemo\u0027]\n\tself.view.custom.toast \u003d \u0027\u0027",
          "sessionScope": false,
          "viewScope": true
        },
        {
          "messageType": "exchange.dashboard.saved",
          "pageScope": true,
          "script": "\t# Sent by the Save popup once the row is written, so the toolbar stops saying\n\t# \"Unsaved\" and a second Save updates the same row.\n\tself.view.custom.currentName \u003d payload[\u0027name\u0027]\n\tself.view.custom.currentIsDemo \u003d payload[\u0027isDemo\u0027]\n\tself.view.custom.toast \u003d \u0027\u0027\n",
          "sessionScope": false,
          "viewScope": true
        },
        {
          "messageType": "exchange.dashboard.setWidgets",
          "pageScope": true,
          "script": "\t# Written by the agent\u0027s writeDashboardConfiguration tool, which lives in the\n\t# Agent Dock and therefore cannot touch this view\u0027s properties directly.\n\tself.view.custom.widgets \u003d payload[\u0027widgets\u0027]\n\tself.view.custom.currentName \u003d \u0027\u0027\n\tself.view.custom.currentIsDemo \u003d False\n\tself.view.custom.toast \u003d \u0027\u0027",
          "sessionScope": true,
          "viewScope": true
        }
      ]
    },
    "type": "ia.container.coord"
  }
}