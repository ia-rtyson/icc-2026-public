                }
              },
              "props.style.boxShadow": {
                "binding": {
                  "config": {
                    "expression": "if({session.props.locale} \u003d \u0027es-MX\u0027, \u00270 0 0 2px var(--callToAction)\u0027, \u0027none\u0027)"
                  },
