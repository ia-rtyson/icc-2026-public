            "paddingTop": 5
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "backgroundColor": "var(--neutral-30)",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
